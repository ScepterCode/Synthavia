# Synthavia AI — local and production environment.
#
# Template. Copy to .env and fill in. The real .env is gitignored; this file is not,
# so never put a real secret in here. Paste the same values into
# Vercel → Project → Settings → Environment Variables when you deploy.
#
# Anything still reading PASTE_ is unset; the app will say so on boot rather than
# starting up half-configured.

# ─────────────────────────────────────────────────────────────────────────────
# 1. SUPABASE — DATABASE
# Dashboard → Project Settings → Database → Connection string
#
# Two URLs are needed and they are NOT interchangeable:
#   • Transaction pooler (port 6543) — what the app uses at runtime. Survives
#     serverless cold starts. Prepared statements are unsupported here, which the
#     driver is configured for.
#   • Session pooler (port 5432) — used for creating tables and migrations.
#     NOTE: Supabase's "Direct connection" host (db.<ref>.supabase.co) is IPv6-only
#     and does not resolve on most networks, so use the session pooler instead:
#     the same host as the transaction pooler, on port 5432.
#
# Replace [YOUR-PASSWORD] in both with the database password you set when creating
# the project. If it contains @ : / or ?, percent-encode it (@ becomes %40).
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_URL=PASTE_TRANSACTION_POOLER_URL_PORT_6543
POSTGRES_URL_DIRECT=PASTE_SESSION_POOLER_URL_PORT_5432

# ─────────────────────────────────────────────────────────────────────────────
# 2. SUPABASE — STORAGE (uploaded team photos and media)
# Dashboard → Storage → New bucket → name it "media" → tick PUBLIC → Create
# Then: Project Settings → API → Project URL, and the service_role key
#
# The service_role key bypasses all access rules. It is server-only: it is never
# sent to the browser and must never appear in public/. Treat it like a password.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=PASTE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=media

# ─────────────────────────────────────────────────────────────────────────────
# 3. FIRST OWNER ACCOUNT
# Leave these BLANK to create the owner in the browser on first visit to /admin.html —
# that way your password is typed by you and never sits in a file. Fill them in only for
# an unattended deploy where you cannot reach the browser first.
# Minimum 12 characters.
# ─────────────────────────────────────────────────────────────────────────────
SYNTHAVIA_ADMIN_EMAIL=
SYNTHAVIA_ADMIN_PASSWORD=
SYNTHAVIA_ADMIN_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# 4. EMAIL (optional — without it, messages queue in the admin Outbox and
# nothing is lost; you press "Retry undelivered" once this is filled in)
# Resend: resend.com → API Keys. The from-address domain must be verified.
# ─────────────────────────────────────────────────────────────────────────────
SYNTHAVIA_EMAIL_ENDPOINT=https://api.resend.com/emails
SYNTHAVIA_EMAIL_KEY=
SYNTHAVIA_EMAIL_FROM=Synthavia AI <no-reply@synthavia.ai>

# ─────────────────────────────────────────────────────────────────────────────
# 5. RUNTIME
# Locally the defaults are fine. On Vercel, HOST/PORT are ignored and TRUST_PROXY
# must be 1 so rate limiting sees the visitor's IP rather than the platform's.
# ─────────────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=4174
TRUST_PROXY=0

# Submissions allowed per IP per 10 minutes. Raise only if a shared office
# connection is being blocked.
SYNTHAVIA_RATE_SUBMIT=5

# Hours between database exports written to data/backups (0 disables).
# Supabase's free tier has no automated backups, so leave this on until you are
# on a paid plan — it is your only safety net for submitted applications.
SYNTHAVIA_BACKUP_HOURS=6

# ─────────────────────────────────────────────────────────────────────────────
# 6. CANONICAL DOMAIN
# The address the site really lives at, with no trailing slash. A Vercel project
# also answers on its *.vercel.app domain, so without this the same page hands
# search engines two different canonical URLs and both copies get indexed.
# Leave blank only for local development.
# ─────────────────────────────────────────────────────────────────────────────
SITE_URL=https://www.example.org
